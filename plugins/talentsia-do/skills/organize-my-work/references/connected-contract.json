{
  "contract": "talentsia-do-connected/v2",
  "status": "pilot_not_connected",
  "max_response_bytes": 65536,
  "tools": [
    {
      "name": "do_access_status",
      "description": "Read current Do Premium access for the validated connection. No purchases or grants.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "contract",
          "access",
          "capabilities"
        ],
        "properties": {
          "contract": {
            "const": "talentsia-do-connected/v2"
          },
          "access": {
            "enum": [
              "active",
              "unavailable"
            ]
          },
          "capabilities": {
            "type": "array",
            "maxItems": 1,
            "uniqueItems": true,
            "items": {
              "const": "plan-my-day"
            }
          }
        }
      }
    },
    {
      "name": "do_plan_my_day_method",
      "description": "Read exact versioned Plan My Day extension, five role instructions and shared prerequisites. Content blocks contain source once; structuredContent maps names to block indices and SHA-256. No execution or writes.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "contract",
          "capability",
          "version",
          "upstream",
          "resources",
          "free_references",
          "resources_sha256",
          "execution",
          "storage",
          "roles",
          "delivery"
        ],
        "properties": {
          "contract": {
            "const": "talentsia-do-connected/v2"
          },
          "capability": {
            "const": "plan-my-day"
          },
          "version": {
            "type": "string",
            "maxLength": 32
          },
          "upstream": {
            "type": "object",
            "maxProperties": 8
          },
          "resources": {
            "type": "object",
            "maxProperties": 9,
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "content_index",
                "sha256"
              ],
              "properties": {
                "content_index": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 14
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          },
          "free_references": {
            "type": "object",
            "maxProperties": 7,
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "content_index",
                "sha256"
              ],
              "properties": {
                "content_index": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 14
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          },
          "resources_sha256": {
            "type": "object",
            "maxProperties": 9,
            "additionalProperties": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "execution": {
            "const": "instructions_only"
          },
          "storage": {
            "const": "not_supplied"
          },
          "roles": {
            "const": "descriptors_only"
          },
          "delivery": {
            "const": "indexed_content"
          }
        }
      }
    }
  ],
  "errors": [
    "authentication_required",
    "invalid_credentials",
    "insufficient_scope",
    "premium_required",
    "service_unavailable",
    "integrity_error",
    "response_too_large",
    "invalid_arguments",
    "unknown_tool"
  ]
}
