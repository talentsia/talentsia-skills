      "documents.inspect@1",
      "documents.register@1",
      "files.workspace@1",
      "work.handoff@1",
      "operator.notify@1"
    ],
    "runtime": ">=0.10.0"
  },
  "model": {
    "minContextTokens": 8192,
    "tiers": [
      "small-local",
      "frontier"
