{
  "schema": "talentsia-skill/v1",
  "id": "talentsia.operations.route-an-arriving-document",
  "version": "2.0.0",
  "status": "draft",
  "publisher": "talentsia",
  "tier": "free",
  "edition": "basic",
  "license": "MIT",
  "targets": [
    "edge-worker"
  ],
  "summary": "Identify what an arriving document is, record it, file it, and pass it to whoever owns that kind of work.",
